#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/masterman/NLP/omniharness/node_modules/.pnpm/@capacitor+cli@8.4.2/node_modules/@capacitor/cli/node_modules:/Users/masterman/NLP/omniharness/node_modules/.pnpm/@capacitor+cli@8.4.2/node_modules:/Users/masterman/NLP/omniharness/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/masterman/NLP/omniharness/node_modules/.pnpm/@capacitor+cli@8.4.2/node_modules/@capacitor/cli/node_modules:/Users/masterman/NLP/omniharness/node_modules/.pnpm/@capacitor+cli@8.4.2/node_modules:/Users/masterman/NLP/omniharness/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@capacitor/cli/bin/capacitor" "$@"
else
  exec node  "$basedir/../@capacitor/cli/bin/capacitor" "$@"
fi
